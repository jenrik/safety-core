{
  "language": "safety-core/bash-policy-v1",
  "layer": "permission",
  "select": [
    {
      "executable": {
        "projection": "basename",
        "equals": "find"
      }
    }
  ],
  "registers": {},
  "folds": {},
  "options": {},
  "fragments": {},
  "start": "args",
  "states": {
    "args": {
      "cases": [
        {
          "when": {
            "call": "executionTargetIs",
            "args": [
              "shell-function"
            ]
          },
          "action": {
            "decision": "deny",
            "reason": [
              "Bash function shadowing of find is blocked. Invoke the external GNU find executable (for example, `command find`) or remove the function."
            ],
            "audit": {
              "invocation": {
                "ref": "event"
              }
            }
          }
        },
        {
          "when": {
            "call": "inStringSet",
            "args": [
              {
                "ref": "word"
              },
              [
                "-exec",
                "-execdir",
                "-ok",
                "-okdir",
                "-delete",
                "-fprint",
                "-fprint0",
                "-fprintf",
                "-fls"
              ]
            ]
          },
          "action": {
            "decision": "defer",
            "audit": {
              "invocation": {
                "ref": "event"
              }
            }
          }
        },
        {
          "when": {
            "all": [
              {
                "call": "atEndOfArguments",
                "args": []
              },
              {
                "call": "executionTargetIs",
                "args": [
                  "external-path"
                ]
              }
            ]
          },
          "action": {
            "decision": "allow",
            "reason": [
              "external GNU find with read-only arguments auto-allowed"
            ],
            "audit": {
              "invocation": {
                "ref": "event"
              }
            }
          }
        },
        {
          "when": {
            "call": "equals",
            "args": [
              {
                "ref": "word"
              },
              {
                "ref": "word"
              }
            ]
          },
          "action": {
            "consume": "word",
            "next": "args"
          }
        }
      ],
      "default": {
        "decision": "defer",
        "audit": {
          "invocation": {
            "ref": "event"
          }
        }
      },
      "end": {
        "decision": "defer",
        "audit": {
          "invocation": {
            "ref": "event"
          }
        }
      }
    }
  }
}
