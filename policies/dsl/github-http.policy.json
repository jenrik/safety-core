{
  "language": "safety-core/bash-policy-v1",
  "layer": "guard",
  "select": [
    { "executable": { "projection": "basename", "equals": "curl" } },
    { "executable": { "projection": "basename", "equals": "wget" } },
    { "executable": { "projection": "basename", "equals": "http" } },
    { "executable": { "projection": "basename", "equals": "httpie" } },
    { "executable": { "projection": "basename", "equals": "fetch" } },
    { "executable": { "projection": "basename", "equals": "httpx" } }
  ],
  "registers": {},
  "folds": {},
  "options": {},
  "fragments": {},
  "start": "start",
  "states": {
    "start": {
      "cases": [
        {
          "when": { "any": [
              { "call": "urlHostEquals", "args": [{ "call": "parseUrl", "args": [{ "ref": "word" }] }, "api.github.com"] },
              { "call": "urlHostEquals", "args": [{ "call": "parseUrl", "args": [{ "ref": "word" }] }, "api.github.com."] },
              { "call": "urlHostEquals", "args": [{ "call": "parseUrl", "args": [{ "ref": "word" }] }, "raw.githubusercontent.com"] },
              { "call": "urlHostEquals", "args": [{ "call": "parseUrl", "args": [{ "ref": "word" }] }, "raw.githubusercontent.com."] }
          ] },
          "action": { "decision": "deny", "reason": [{ "call": "githubHttpReason", "args": [{ "ref": "word" }] }], "audit": { "invocation": { "ref": "event" } } }
        },
        { "when": true, "action": { "consume": "word", "next": "scan" } }
      ],
      "default": { "decision": "ignore" },
      "end": { "decision": "ignore" }
    },
    "scan": {
      "cases": [
        {
          "when": { "any": [
            { "call": "urlHostEquals", "args": [{ "call": "parseUrl", "args": [{ "ref": "word" }] }, "api.github.com"] },
            { "call": "urlHostEquals", "args": [{ "call": "parseUrl", "args": [{ "ref": "word" }] }, "api.github.com."] },
            { "call": "urlHostEquals", "args": [{ "call": "parseUrl", "args": [{ "ref": "word" }] }, "raw.githubusercontent.com"] },
            { "call": "urlHostEquals", "args": [{ "call": "parseUrl", "args": [{ "ref": "word" }] }, "raw.githubusercontent.com."] }
          ] },
          "action": { "decision": "deny", "reason": [{ "call": "githubHttpReason", "args": [{ "ref": "word" }] }], "audit": { "invocation": { "ref": "event" } } }
        },
        { "when": true, "action": { "consume": "word", "next": "scan" } }
      ],
      "default": { "decision": "ignore" },
      "end": { "decision": "ignore" }
    }
  }
}
