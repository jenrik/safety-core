{
  "language": "safety-core/bash-policy-v1",
  "layer": "guard",
  "select": [{ "kind": "invocation" }],
  "registers": {},
  "folds": {
    "hasSecretRedirect": { "collection": "redirects", "operation": "any", "when": { "all": [
      { "not": { "call": "anySafeGlob", "args": [{ "call": "asciiLower", "args": [{ "call": "basename", "args": [{ "ref": "fold.item" }] }] }, ["*.env.example", "*.env.sample", "*.env.template", "*.env.dist"]] } },
      { "call": "anySafeGlob", "args": [{ "call": "asciiLower", "args": [{ "call": "basename", "args": [{ "ref": "fold.item" }] }] }, ["*.env", "*.env.*", ".envrc", "*.pem", "*.key", "id_rsa*", "id_ed25519*", "id_dsa*", "id_ecdsa*", "*.p12", "*.pfx", "*.pkcs12", ".netrc", "credentials.json", "credentials.yaml", "credentials.yml", "*-credentials.json", "*-credentials.yaml", "*-credentials.yml", "*.credentials.json", "*.credentials.yaml", "*.credentials.yml", "service-account*.json", "service_account*.json", "secrets.json", "secrets.yaml", "secrets.yml", "*-secrets.json", "*-secrets.yaml", "*-secrets.yml", "*.secrets.json", "*.secrets.yaml", "*.secrets.yml", "*.secret.json", "*.secret.yaml", "*.secret.yml", "kubeconfig"]] }
    ] } },
    "firstSecretRedirect": { "collection": "redirects", "operation": "firstRef", "when": { "all": [
      { "not": { "call": "anySafeGlob", "args": [{ "call": "asciiLower", "args": [{ "call": "basename", "args": [{ "ref": "fold.item" }] }] }, ["*.env.example", "*.env.sample", "*.env.template", "*.env.dist"]] } },
      { "call": "anySafeGlob", "args": [{ "call": "asciiLower", "args": [{ "call": "basename", "args": [{ "ref": "fold.item" }] }] }, ["*.env", "*.env.*", ".envrc", "*.pem", "*.key", "id_rsa*", "id_ed25519*", "id_dsa*", "id_ecdsa*", "*.p12", "*.pfx", "*.pkcs12", ".netrc", "credentials.json", "credentials.yaml", "credentials.yml", "*-credentials.json", "*-credentials.yaml", "*-credentials.yml", "*.credentials.json", "*.credentials.yaml", "*.credentials.yml", "service-account*.json", "service_account*.json", "secrets.json", "secrets.yaml", "secrets.yml", "*-secrets.json", "*-secrets.yaml", "*-secrets.yml", "*.secrets.json", "*.secrets.yaml", "*.secrets.yml", "*.secret.json", "*.secret.yaml", "*.secret.yml", "kubeconfig"]] }
    ] } },
    "hasSecretOperand": { "collection": "argv", "operation": "any", "when": { "all": [
      { "not": { "call": "startsWith", "args": [{ "ref": "fold.item" }, "-"] } },
      { "not": { "call": "anySafeGlob", "args": [{ "call": "asciiLower", "args": [{ "call": "basename", "args": [{ "ref": "fold.item" }] }] }, ["*.env.example", "*.env.sample", "*.env.template", "*.env.dist"]] } },
      { "call": "anySafeGlob", "args": [{ "call": "asciiLower", "args": [{ "call": "basename", "args": [{ "ref": "fold.item" }] }] }, ["*.env", "*.env.*", ".envrc", "*.pem", "*.key", "id_rsa*", "id_ed25519*", "id_dsa*", "id_ecdsa*", "*.p12", "*.pfx", "*.pkcs12", ".netrc", "credentials.json", "credentials.yaml", "credentials.yml", "*-credentials.json", "*-credentials.yaml", "*-credentials.yml", "*.credentials.json", "*.credentials.yaml", "*.credentials.yml", "service-account*.json", "service_account*.json", "secrets.json", "secrets.yaml", "secrets.yml", "*-secrets.json", "*-secrets.yaml", "*-secrets.yml", "*.secrets.json", "*.secrets.yaml", "*.secrets.yml", "*.secret.json", "*.secret.yaml", "*.secret.yml", "kubeconfig"]] }
    ] } },
    "firstSecretOperand": { "collection": "argv", "operation": "firstRef", "when": { "all": [
      { "not": { "call": "startsWith", "args": [{ "ref": "fold.item" }, "-"] } },
      { "not": { "call": "anySafeGlob", "args": [{ "call": "asciiLower", "args": [{ "call": "basename", "args": [{ "ref": "fold.item" }] }] }, ["*.env.example", "*.env.sample", "*.env.template", "*.env.dist"]] } },
      { "call": "anySafeGlob", "args": [{ "call": "asciiLower", "args": [{ "call": "basename", "args": [{ "ref": "fold.item" }] }] }, ["*.env", "*.env.*", ".envrc", "*.pem", "*.key", "id_rsa*", "id_ed25519*", "id_dsa*", "id_ecdsa*", "*.p12", "*.pfx", "*.pkcs12", ".netrc", "credentials.json", "credentials.yaml", "credentials.yml", "*-credentials.json", "*-credentials.yaml", "*-credentials.yml", "*.credentials.json", "*.credentials.yaml", "*.credentials.yml", "service-account*.json", "service_account*.json", "secrets.json", "secrets.yaml", "secrets.yml", "*-secrets.json", "*-secrets.yaml", "*-secrets.yml", "*.secrets.json", "*.secrets.yaml", "*.secrets.yml", "*.secret.json", "*.secret.yaml", "*.secret.yml", "kubeconfig"]] }
    ] } }
  },
  "options": {},
  "fragments": {},
  "start": "start",
  "states": {
    "start": {
      "cases": [
        { "when": { "all": [{ "ref": "fold.hasSecretRedirect" }, { "call": "inputIsBindingResolved", "args": [{ "ref": "fold.firstSecretRedirect" }] }] }, "action": { "decision": "deny", "fold": ["hasSecretRedirect", "firstSecretRedirect"], "reason": ["bash redirect from a protected secret file"], "audit": { "invocation": { "ref": "event" } } } },
        { "when": { "ref": "fold.hasSecretRedirect" }, "action": { "decision": "deny", "fold": ["hasSecretRedirect", "firstSecretRedirect"], "capture": { "target": { "call": "basename", "args": [{ "ref": "fold.firstSecretRedirect" }] } }, "reason": ["bash redirect from '", { "ref": "capture.target" }, "'"], "audit": { "invocation": { "ref": "event" } } } },
        { "when": { "all": [{ "call": "inStringSet", "args": [{ "call": "basename", "args": [{ "ref": "event.executable" }] }, ["cat", "head", "tail", "less", "bat", "more", "view", "xxd", "od", "hexdump", "strings", "source", "."]] }, { "ref": "fold.hasSecretOperand" }, { "call": "inputIsBindingResolved", "args": [{ "ref": "fold.firstSecretOperand" }] }] }, "action": { "decision": "deny", "fold": ["hasSecretOperand", "firstSecretOperand"], "capture": { "executable": { "ref": "event.executable" } }, "reason": ["bash `", { "ref": "capture.executable" }, "` on a protected secret file"], "audit": { "invocation": { "ref": "event" } } } },
        { "when": { "all": [{ "call": "inStringSet", "args": [{ "call": "basename", "args": [{ "ref": "event.executable" }] }, ["cat", "head", "tail", "less", "bat", "more", "view", "xxd", "od", "hexdump", "strings", "source", "."]] }, { "ref": "fold.hasSecretOperand" }] }, "action": { "decision": "deny", "fold": ["hasSecretOperand", "firstSecretOperand"], "capture": { "executable": { "ref": "event.executable" }, "target": { "call": "basename", "args": [{ "ref": "fold.firstSecretOperand" }] } }, "reason": ["bash `", { "ref": "capture.executable" }, "` on '", { "ref": "capture.target" }, "'"], "audit": { "invocation": { "ref": "event" } } } }
      ],
      "default": { "decision": "ignore" },
      "end": { "decision": "ignore" }
    }
  }
}
