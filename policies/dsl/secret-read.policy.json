{
  "language": "safety-core/bash-policy-v1",
  "layer": "guard",
  "select": [{ "kind": "invocation" }],
  "registers": {},
  "folds": {},
  "options": {},
  "fragments": {},
  "start": "start",
  "states": {
    "start": {
      "cases": [
        {
          "when": { "all": [
            { "call": "inStringSet", "args": [{ "call": "basename", "args": [{ "ref": "event.executable" }] }, ["cat", "head", "tail", "less", "bat", "more", "view", "xxd", "od", "hexdump", "strings", "source", "."]] },
            { "any": [
              { "call": "equals", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "credentials.json"] },
              { "all": [
                { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.env"] },
                { "not": { "any": [
                  { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.env.example"] },
                  { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.env.sample"] },
                  { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.env.template"] },
                  { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.env.dist"] }
                ] } }
              ] }
            ] }
          ] },
          "action": { "decision": "deny", "reason": ["bash reader on a protected secret file"], "audit": { "invocation": { "ref": "event" } } }
        },
        {
          "when": { "any": [
            { "call": "redirectHasInputPath", "args": ["credentials.json"] },
            { "call": "redirectHasInputPath", "args": ["credentials.yaml"] },
            { "call": "redirectHasInputPath", "args": ["credentials.yml"] },
            { "call": "redirectHasInputPath", "args": [".envrc"] },
            { "call": "redirectHasInputPath", "args": [".netrc"] },
            { "call": "redirectHasInputPath", "args": ["kubeconfig"] }
          ] },
          "action": { "decision": "deny", "reason": ["bash redirect from a protected secret file"], "audit": { "invocation": { "ref": "event" } } }
        },
        {
          "when": { "call": "inStringSet", "args": [
            { "call": "basename", "args": [{ "ref": "event.executable" }] },
            ["cat", "head", "tail", "less", "bat", "more", "view", "xxd", "od", "hexdump", "strings", "source", "."]
          ] },
          "action": { "consume": "word", "next": "scan" }
        }
      ],
      "default": { "decision": "ignore" },
      "end": { "decision": "ignore" }
    },
    "scan": {
      "cases": [
        {
          "when": { "all": [
            { "not": { "any": [
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.env.example"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.env.sample"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.env.template"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.env.dist"] }
            ] } },
            { "any": [
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.env"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.env.*"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, ".envrc"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.pem"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.key"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "id_rsa*"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "id_ed25519*"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "id_dsa*"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "id_ecdsa*"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.p12"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.pfx"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.pkcs12"] },
              { "call": "inStringSet", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, [".netrc", "credentials.json", "credentials.yaml", "credentials.yml", "secrets.json", "secrets.yaml", "secrets.yml", "kubeconfig"]] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*-credentials.json"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*-credentials.yaml"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*-credentials.yml"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.credentials.json"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.credentials.yaml"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.credentials.yml"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "service-account*.json"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "service_account*.json"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*-secrets.json"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*-secrets.yaml"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*-secrets.yml"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.secrets.json"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.secrets.yaml"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.secrets.yml"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.secret.json"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.secret.yaml"] },
              { "call": "safeGlob", "args": [{ "call": "basename", "args": [{ "ref": "word" }] }, "*.secret.yml"] }
            ] }
          ] },
          "action": { "decision": "deny", "reason": ["bash reader on a protected secret file"], "audit": { "invocation": { "ref": "event" } } }
        },
        { "when": true, "action": { "consume": "word", "next": "scan" } }
      ],
      "default": { "decision": "ignore" },
      "end": { "decision": "ignore" }
    }
  }
}
