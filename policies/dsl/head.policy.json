{
  "language": "safety-core/bash-policy-v1",
  "layer": "permission",
  "select": [{ "executable": { "projection": "basename", "equals": "head" } }],
  "registers": {},
  "folds": {},
  "options": {},
  "fragments": {},
  "start": "start",
  "states": {
    "start": {
      "cases": [
        {
          "when": { "call": "executionTargetIs", "args": ["shell-function"] },
          "action": {
            "decision": "deny",
            "reason": ["Bash function shadowing of head is blocked. Invoke the external GNU head executable (for example, `command head`) or remove the function."],
            "audit": { "invocation": { "ref": "event" } }
          }
        },
        {
          "when": { "call": "executionTargetIs", "args": ["external-path"] },
          "action": {
            "decision": "allow",
            "reason": ["external executable with basename head auto-allowed"],
            "audit": { "invocation": { "ref": "event" } }
          }
        }
      ],
      "default": { "decision": "defer", "audit": { "invocation": { "ref": "event" } } },
      "end": { "decision": "defer", "audit": { "invocation": { "ref": "event" } } }
    }
  }
}
