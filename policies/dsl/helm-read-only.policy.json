{
  "language": "safety-core/bash-policy-v1",
  "layer": "permission",
  "select": [
    {
      "executable": {
        "projection": "basename",
        "equals": "helm"
      }
    }
  ],
  "registers": {},
  "folds": {
    "hasSecretOperand": {
      "collection": "argv",
      "operation": "any",
      "when": {
        "all": [
          {
            "not": {
              "call": "startsWith",
              "args": [
                {
                  "ref": "fold.item"
                },
                "-"
              ]
            }
          },
          {
            "not": {
              "call": "anySafeGlob",
              "args": [
                {
                  "call": "asciiLower",
                  "args": [
                    {
                      "call": "basename",
                      "args": [
                        {
                          "ref": "fold.item"
                        }
                      ]
                    }
                  ]
                },
                [
                  "*.env.example",
                  "*.env.sample",
                  "*.env.template",
                  "*.env.dist"
                ]
              ]
            }
          },
          {
            "call": "anySafeGlob",
            "args": [
              {
                "call": "asciiLower",
                "args": [
                  {
                    "call": "basename",
                    "args": [
                      {
                        "ref": "fold.item"
                      }
                    ]
                  }
                ]
              },
              [
                "*.env",
                "*.env.*",
                ".envrc",
                "*.pem",
                "*.key",
                "id_rsa*",
                "id_ed25519*",
                "id_dsa*",
                "id_ecdsa*",
                "*.p12",
                "*.pfx",
                "*.pkcs12",
                ".netrc",
                "credentials.json",
                "credentials.yaml",
                "credentials.yml",
                "*-credentials.json",
                "*-credentials.yaml",
                "*-credentials.yml",
                "*.credentials.json",
                "*.credentials.yaml",
                "*.credentials.yml",
                "service-account*.json",
                "service_account*.json",
                "secrets.json",
                "secrets.yaml",
                "secrets.yml",
                "*-secrets.json",
                "*-secrets.yaml",
                "*-secrets.yml",
                "*.secrets.json",
                "*.secrets.yaml",
                "*.secrets.yml",
                "*.secret.json",
                "*.secret.yaml",
                "*.secret.yml",
                "kubeconfig"
              ]
            ]
          }
        ]
      }
    }
  },
  "options": {},
  "fragments": {},
  "start": "start",
  "states": {
    "start": {
      "cases": [
        {
          "when": {
            "call": "equals",
            "args": [
              {
                "ref": "word"
              },
              "--help"
            ]
          },
          "action": {
            "consume": "word",
            "next": "exact"
          }
        },
        {
          "when": {
            "call": "equals",
            "args": [
              {
                "ref": "word"
              },
              "--version"
            ]
          },
          "action": {
            "consume": "word",
            "next": "exact"
          }
        },
        {
          "when": {
            "call": "equals",
            "args": [
              {
                "ref": "word"
              },
              "help"
            ]
          },
          "action": {
            "consume": "word",
            "next": "accepted"
          }
        },
        {
          "when": {
            "call": "equals",
            "args": [
              {
                "ref": "word"
              },
              "completion"
            ]
          },
          "action": {
            "consume": "word",
            "next": "accepted"
          }
        },
        {
          "when": {
            "call": "equals",
            "args": [
              {
                "ref": "word"
              },
              "verify"
            ]
          },
          "action": {
            "consume": "word",
            "next": "accepted"
          }
        },
        {
          "when": {
            "call": "equals",
            "args": [
              {
                "ref": "word"
              },
              "show"
            ]
          },
          "action": {
            "consume": "word",
            "next": "show"
          }
        },
        {
          "when": {
            "call": "equals",
            "args": [
              {
                "ref": "word"
              },
              "inspect"
            ]
          },
          "action": {
            "consume": "word",
            "next": "inspect"
          }
        },
        {
          "when": {
            "call": "equals",
            "args": [
              {
                "ref": "word"
              },
              "search"
            ]
          },
          "action": {
            "consume": "word",
            "next": "search"
          }
        },
        {
          "when": {
            "call": "equals",
            "args": [
              {
                "ref": "word"
              },
              "version"
            ]
          },
          "action": {
            "consume": "word",
            "next": "exact"
          }
        }
      ],
      "default": {
        "decision": "defer",
        "audit": {
          "invocation": {
            "ref": "event"
          }
        },
        "fold": [
          "hasSecretOperand"
        ]
      },
      "end": {
        "decision": "defer",
        "audit": {
          "invocation": {
            "ref": "event"
          }
        },
        "fold": [
          "hasSecretOperand"
        ]
      }
    },
    "exact": {
      "cases": [],
      "default": {
        "decision": "defer",
        "audit": {
          "invocation": {
            "ref": "event"
          }
        },
        "fold": [
          "hasSecretOperand"
        ]
      },
      "end": {
        "decision": "allow",
        "reason": [
          "helm auto-allowed by the read-only profile"
        ],
        "audit": {
          "invocation": {
            "ref": "event"
          }
        },
        "fold": [
          "hasSecretOperand"
        ]
      }
    },
    "accepted": {
      "cases": [
        {
          "when": true,
          "action": {
            "consume": "word",
            "next": "accepted"
          }
        }
      ],
      "default": {
        "decision": "defer",
        "audit": {
          "invocation": {
            "ref": "event"
          }
        },
        "fold": [
          "hasSecretOperand"
        ]
      },
      "end": {
        "decision": "allow",
        "reason": [
          "helm auto-allowed by the read-only profile"
        ],
        "audit": {
          "invocation": {
            "ref": "event"
          }
        },
        "fold": [
          "hasSecretOperand"
        ]
      }
    },
    "show": {
      "cases": [
        {
          "when": {
            "call": "equals",
            "args": [
              {
                "ref": "word"
              },
              "chart"
            ]
          },
          "action": {
            "consume": "word",
            "next": "showChart"
          }
        }
      ],
      "default": {
        "decision": "defer",
        "audit": {
          "invocation": {
            "ref": "event"
          }
        },
        "fold": [
          "hasSecretOperand"
        ]
      },
      "end": {
        "decision": "defer",
        "audit": {
          "invocation": {
            "ref": "event"
          }
        },
        "fold": [
          "hasSecretOperand"
        ]
      }
    },
    "inspect": {
      "cases": [
        {
          "when": {
            "call": "equals",
            "args": [
              {
                "ref": "word"
              },
              "chart"
            ]
          },
          "action": {
            "consume": "word",
            "next": "showChart"
          }
        }
      ],
      "default": {
        "decision": "defer",
        "audit": {
          "invocation": {
            "ref": "event"
          }
        },
        "fold": [
          "hasSecretOperand"
        ]
      },
      "end": {
        "decision": "defer",
        "audit": {
          "invocation": {
            "ref": "event"
          }
        },
        "fold": [
          "hasSecretOperand"
        ]
      }
    },
    "showChart": {
      "cases": [
        {
          "when": true,
          "action": {
            "consume": "word",
            "next": "exact"
          }
        }
      ],
      "default": {
        "decision": "defer",
        "audit": {
          "invocation": {
            "ref": "event"
          }
        },
        "fold": [
          "hasSecretOperand"
        ]
      },
      "end": {
        "decision": "defer",
        "audit": {
          "invocation": {
            "ref": "event"
          }
        },
        "fold": [
          "hasSecretOperand"
        ]
      }
    },
    "search": {
      "cases": [
        {
          "when": {
            "call": "equals",
            "args": [
              {
                "ref": "word"
              },
              "hub"
            ]
          },
          "action": {
            "consume": "word",
            "next": "accepted"
          }
        },
        {
          "when": {
            "call": "equals",
            "args": [
              {
                "ref": "word"
              },
              "repo"
            ]
          },
          "action": {
            "consume": "word",
            "next": "accepted"
          }
        }
      ],
      "default": {
        "decision": "defer",
        "audit": {
          "invocation": {
            "ref": "event"
          }
        },
        "fold": [
          "hasSecretOperand"
        ]
      },
      "end": {
        "decision": "defer",
        "audit": {
          "invocation": {
            "ref": "event"
          }
        },
        "fold": [
          "hasSecretOperand"
        ]
      }
    }
  }
}
