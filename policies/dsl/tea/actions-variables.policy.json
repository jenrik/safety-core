{
  "language": "safety-core/bash-policy-v1",
  "layer": "permission",
  "select": [{ "executable": { "projection": "basename", "equals": "tea" } }],
  "registers": {}, "folds": {},
  "options": {
    "login": { "names": ["--login"], "value": "required", "forms": ["separate", "equalsLong"], "availableIn": ["actions", "variables"], "set": {} },
    "repo": { "names": ["--repo"], "value": "required", "forms": ["separate", "equalsLong"], "availableIn": ["actions", "variables"], "set": {} },
    "output": { "names": ["--output", "-o"], "value": "required", "forms": ["separate", "equalsLong"], "availableIn": ["actions", "variables"], "set": {} }
  },
  "fragments": {
    "allowAtEnd": { "cases": [{ "when": { "all": [{ "call": "atEndOfArguments", "args": [] }, {"call":"executionTargetIs","args":["external-path"]},{ "call": "isDirectExecutable", "args": ["tea"] }, { "not": { "call": "hasAnyAssignment", "args": [] } }, { "not": { "call": "hasRedirect", "args": [] } }, { "not": { "call": "hasInheritedExecutableFunction", "args": ["tea"] } }] }, "action": { "decision": "allow", "reason": ["tea actions variables default listing auto-allowed by the read-only route profile"], "audit": { "invocation": { "ref": "event" } } } }] }
  },
  "start": "start",
  "states": {
    "start": { "cases": [{ "when": { "not": { "all": [{ "call": "executionTargetIs", "args": ["external-path"] }, { "call": "isDirectExecutable", "args": ["tea"] }] } }, "action": { "decision": "defer" } }, { "when": { "call": "inStringSet", "args": [{ "ref": "word" }, ["actions", "action"]] }, "action": { "consume": "word", "next": "actions" } }], "default": { "decision": "defer" }, "end": { "decision": "defer" } },
    "actions": { "cases": [{ "when": { "call": "inStringSet", "args": [{ "ref": "word" }, ["variables", "variable", "vars", "var"]] }, "action": { "consume": "word", "next": "variables" } }], "default": { "decision": "defer" }, "end": { "decision": "defer" } },
    "variables": { "fragments": ["allowAtEnd"], "cases": [{ "when": { "call": "inStringSet", "args": [{ "ref": "word" }, ["list", "ls", "set", "create", "update", "delete", "remove", "rm"]] }, "action": { "decision": "defer" } }], "default": { "decision": "defer" }, "end": { "decision": "defer" } }
  }
}
