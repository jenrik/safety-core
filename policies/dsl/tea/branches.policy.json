{
  "language": "safety-core/bash-policy-v1",
  "layer": "permission",
  "select": [{ "executable": { "projection": "basename", "equals": "tea" } }],
  "registers": {}, "folds": {},
  "options": {
    "comments": { "names": ["--comments"], "value": "optional", "forms": ["equalsLong"], "availableIn": ["branches", "detail"], "set": {} },
    "fields": { "names": ["--fields", "-f"], "value": "required", "forms": ["separate", "equalsLong"], "availableIn": ["branches", "detail"], "set": {} },
    "page": { "names": ["--page", "-p"], "value": "required", "forms": ["separate", "equalsLong"], "availableIn": ["branches", "detail"], "set": {} },
    "limit": { "names": ["--limit", "--lm", "-lm"], "value": "required", "forms": ["separate", "equalsLong"], "availableIn": ["branches", "detail"], "set": {} },
    "login": { "names": ["--login", "-l"], "value": "required", "forms": ["separate", "equalsLong"], "availableIn": ["branches", "detail"], "set": {} },
    "repo": { "names": ["--repo", "-r"], "value": "required", "forms": ["separate", "equalsLong"], "availableIn": ["branches", "detail"], "set": {} },
    "remote": { "names": ["--remote", "-R"], "value": "required", "forms": ["separate", "equalsLong"], "availableIn": ["branches", "detail"], "set": {} },
    "output": { "names": ["--output", "-o"], "value": "required", "forms": ["separate", "equalsLong"], "availableIn": ["branches", "detail"], "set": {} }
  },
  "fragments": {
    "allowAtEnd": { "cases": [{ "when": { "all": [{ "call": "atEndOfArguments", "args": [] }, {"call":"executionTargetIs","args":["external-path"]},{ "call": "isDirectExecutable", "args": ["tea"] }, { "not": { "call": "hasAnyAssignment", "args": [] } }, { "not": { "call": "hasRedirect", "args": [] } }, { "not": { "call": "hasInheritedExecutableFunction", "args": ["tea"] } }] }, "action": { "decision": "allow", "reason": ["tea branches default listing auto-allowed by the read-only route profile"], "audit": { "invocation": { "ref": "event" } } } }] }
  },
  "start": "start",
  "states": {
    "start": { "cases": [{ "when": { "not": { "all": [{ "call": "executionTargetIs", "args": ["external-path"] }, { "call": "isDirectExecutable", "args": ["tea"] }] } }, "action": { "decision": "defer" } }, { "when": { "call": "inStringSet", "args": [{ "ref": "word" }, ["branches", "branch", "b"]] }, "action": { "consume": "word", "next": "branches" } }], "default": { "decision": "defer" }, "end": { "decision": "defer" } },
    "branches": { "fragments": ["allowAtEnd"], "cases": [{ "when": { "call": "inStringSet", "args": [{ "ref": "word" }, ["list", "ls", "protect", "P", "unprotect", "U", "rename", "rn"]] }, "action": { "decision": "defer" } }, { "when": { "not": { "call": "startsWith", "args": [{ "ref": "word" }, "-"] } }, "action": { "consume": "word", "next": "detail" } }], "default": { "decision": "defer" }, "end": { "decision": "defer" } },
    "detail": { "fragments": ["allowAtEnd"], "cases": [], "default": { "decision": "defer" }, "end": { "decision": "defer" } }
  }
}
