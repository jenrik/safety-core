{
  "language": "safety-core/bash-policy-v1",
  "layer": "permission",
  "select": [{ "executable": { "projection": "basename", "equals": "tea" }, "environmentIndependent": true }],
  "registers": {}, "folds": {},
  "options": {
    "repo": { "names": ["--repo", "-r"], "value": "required", "forms": ["separate", "equalsLong"], "availableIn": ["wiki"], "set": {} },
    "remote": { "names": ["--remote", "-R"], "value": "required", "forms": ["separate", "equalsLong"], "availableIn": ["wiki"], "set": {} },
    "login": { "names": ["--login", "-l"], "value": "required", "forms": ["separate", "equalsLong"], "availableIn": ["wiki"], "set": {} },
    "output": { "names": ["--output", "-o"], "value": "required", "forms": ["separate", "equalsLong"], "availableIn": ["wiki"], "set": {} },
    "fields": { "names": ["--fields", "-f"], "value": "required", "forms": ["separate", "equalsLong"], "availableIn": ["wiki"], "set": {} },
    "page": { "names": ["--page", "-p"], "value": "required", "forms": ["separate", "equalsLong"], "availableIn": ["wiki"], "set": {} },
    "limit": { "names": ["--limit", "--lm", "-lm"], "value": "required", "forms": ["separate", "equalsLong"], "availableIn": ["wiki"], "set": {} }
  },
  "fragments": { "allowAtEnd": { "cases": [{ "when": { "all": [{ "call": "atEndOfArguments", "args": [] }, {"call":"executionTargetIs","args":["external-path"]},{ "call": "isDirectExecutable", "args": ["tea"] }, { "not": { "call": "hasAnyAssignment", "args": [] } }, { "not": { "call": "hasRedirect", "args": [] } }, { "not": { "call": "hasInheritedExecutableFunction", "args": ["tea"] } }] }, "action": { "decision": "allow", "reason": ["tea wiki auto-allowed by the read-only profile"], "audit": { "invocation": { "ref": "event" } } } }] } },
  "start": "start",
  "states": {
    "start": { "cases": [{ "when": { "call": "equals", "args": [{ "ref": "word" }, "wiki"] }, "action": { "consume": "word", "next": "wiki" } }], "default": { "decision": "defer" }, "end": { "decision": "defer" } },
    "wiki": { "fragments": ["allowAtEnd"], "cases": [{ "when": { "call": "inStringSet", "args": [{ "ref": "word" }, ["list", "ls", "view", "revisions", "history"]] }, "action": { "decision": "ignore" } }], "default": { "decision": "defer" }, "end": { "decision": "defer" } }
  }
}
