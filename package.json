{
  "name": "safety-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript safety-policy core for pi/opencode/claude-code coding-agent hooks",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:native-packages": "bun scripts/build-native-node-packages.ts",
    "generate:prompt-proto": "bun scripts/generate-prompt-proto.ts",
    "typescheck": "tsc --noEmit",
    "test": "bun run build:native-packages && bun test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@safety-core/core": "file:packages/core",
    "@safety-core/claude-code": "file:packages/claude-code",
    "@safety-core/opencode-v1": "file:packages/opencode-v1",
    "@safety-core/pi": "file:packages/pi",
    "web-tree-sitter": "0.26.11",
    "tree-sitter-bash": "0.25.1"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@opencode-ai/plugin": "1.18.32",
    "@types/bun": "1.3.13",
    "tree-sitter-cli": "0.26.11",
    "typescript": "5.9.3"
  }
}
