  "fragments": {},
  "start": "start",
  "states": {
    "start": {
      "cases": [
        {
          "when": {
            "all": [
              {
                "call": "isDirectExecutable",
                "args": [
                  "bun"
                ]
              },
              {
                "call": "executionTargetIs",
                "args": [
                  "external-path"
                ]
              },
              {
                "not": {
                  "call": "hasAnyAssignment",
                  "args": []
                }
              },
              {
                "call": "equals",
                "args": [
                  {
                    "ref": "word"
                  },
                  "test"
                ]
              }
            ]
          },
          "action": {
            "consume": "word",
            "next": "selection"
          }
        }
      ],
      "default": {
        "decision": "defer",
        "audit": {
          "invocation": {
            "ref": "event"
          }
        }
      },
      "end": {
        "decision": "defer",
        "audit": {
          "invocation": {
            "ref": "event"
          }
        }
      }
    },
    "selection": {
      "cases": [
        {
          "when": {
            "all": [
              {
                "call": "atEndOfArguments",
                "args": []
              },
              {
                "ref": "fold.noTerminator"
              }
            ]
          },
          "action": {
            "decision": "allow",
            "reason": [
              "bun test with reviewed flags and project-relative selection auto-allowed by the project bun-test policy"
            ],
            "fold": [
              "noTerminator"
            ],
            "audit": {
              "invocation": {
                "ref": "event"
              }
            }
          }
        },
        {
          "when": {
            "all": [
              {
                "not": {
                  "call": "startsWith",
                  "args": [
                    {
                      "ref": "word"
                    },
                    "-"
                  ]
                }
              },
              {
                "not": {
                  "call": "startsWith",
                  "args": [
                    {
                      "ref": "word"
                    },
                    "/"
                  ]
                }
              },
              {
                "not": {
                  "call": "startsWith",
                  "args": [
                    {
                      "ref": "word"
                    },
                    "~"
                  ]
                }
              },
              {
                "not": {
                  "call": "equals",
                  "args": [
                    {
                      "ref": "word"
                    },
                    ".."
                  ]
                }
              },
              {
                "not": {
                  "call": "includes",
                  "args": [
                    {
                      "ref": "word"
                    },
                    "../"
                  ]
                }
              },
              {
                "not": {
                  "call": "endsWith",
                  "args": [
                    {
                      "ref": "word"
                    },
                    "/.."
                  ]
                }
              }
            ]
          },
          "action": {
            "consume": "word",
            "next": "selection"
          }
        }
      ],
      "default": {
        "decision": "defer",
        "audit": {
          "invocation": {
            "ref": "event"
          }
        }
      },
      "end": {
        "decision": "defer",
        "audit": {
          "invocation": {
            "ref": "event"
          }
        }
      }
    }
  }
}
