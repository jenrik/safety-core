{
  "language": "safety-core/bash-policy-v1",
  "layer": "permission",
  "select": [
    {
      "executable": {
        "projection": "basename",
        "equals": "bun"
      }
    }
  ],
  "registers": {},
  "folds": {
    "noTerminator": {
      "collection": "argv",
      "operation": "all",
      "when": {
        "not": {
          "call": "equals",
          "args": [
            {
              "ref": "fold.item"
            },
            "--"
          ]
        }
      }
    }
  },
  "options": {
    "testNamePattern": {
      "names": [
        "-t",
        "--test-name-pattern"
      ],
      "value": "required",
      "forms": [
        "separate",
        "attachedShort",
        "equalsLong"
      ],
      "availableIn": [
        "selection"
      ],
      "set": {}
    },
    "timeout": {
      "names": [
        "--timeout"
      ],
      "value": "required",
      "forms": [
